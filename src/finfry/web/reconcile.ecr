<% v = @view %>
<% out_label, in_label = v.column_labels %>
<header class="page-head">
  <h1>Reconcile <span class="muted"><%= h v.account %></span></h1>
  <p class="sub">Tick each line that appears on the statement. Commit once the cleared balance equals the statement's. <a href="/reconcile">All accounts</a></p>
</header>

<form class="filters statement-strip" method="get" action="/reconcile">
  <input type="hidden" name="account" value="<%= h v.account %>">
  <label>Statement date <input type="date" name="as_of" value="<%= h @as_of %>"></label>
  <label>Statement balance <input name="statement" value="<%= h(@statement || "") %>" size="10" inputmode="decimal" placeholder="closing balance" autofocus></label>
  <button type="submit">Check</button>
  <% if last = v.last %><span class="muted starting">Starting balance <span class="num"><%= Money.format last.statement %></span> as of <%= last.as_of %></span><% end %>
</form>

<section class="recon-summary">
  <div class="stat"><span class="label">Cleared balance</span><span class="figure" data-field="cleared"><%= money v.cleared %></span><span class="note"><span data-field="staged"><%= v.staged_count %></span> of <%= v.rows.size %> ticked · <%= out_label.downcase %> <span data-field="cleared_out" class="num"><%= Money.format v.cleared_out %></span> · <%= in_label.downcase %> <span data-field="cleared_in" class="num"><%= Money.format v.cleared_in %></span></span></div>
  <div class="stat"><span class="label">Ledger balance</span><span class="figure" data-field="ledger"><%= money v.ledger %></span><span class="note">everything recorded</span></div>
  <% if st = v.statement %>
    <div class="stat verdict" data-field="verdict" data-matches="<%= v.matches? %>">
      <span class="label">Statement<% if d = v.as_of %> · <%= d %><% end %></span><span class="figure"><%= money st %></span>
      <span class="note"><% if v.matches? %><span class="tick">✓</span> matches the cleared balance<% else %><span class="warn">⚠</span> off by <span data-field="difference"><%= money v.difference.not_nil! %></span><% end %></span>
    </div>
  <% else %>
    <div class="stat"><span class="label">Statement</span><span class="figure muted">—</span><span class="note">enter the closing balance above to check</span></div>
  <% end %>
</section>

<% if v.rows.empty? %>
  <p class="empty">Nothing to reconcile — every transaction on <%= h v.account %> is already committed.</p>
<% else %>
  <form method="post" action="/reconcile/mark" data-autosave>
    <input type="hidden" name="account" value="<%= h v.account %>" data-ctx>
    <% if @statement %><input type="hidden" name="statement" value="<%= h @statement %>" data-ctx><% end %>
    <% if v.as_of %><input type="hidden" name="as_of" value="<%= h v.as_of.not_nil! %>" data-ctx><% end %>
    <table class="ledger">
      <thead><tr><th class="check-col">On statement</th><th>#</th><th>Date</th><th>Memo</th><th class="num-col"><%= out_label %></th><th class="num-col"><%= in_label %></th></tr></thead>
      <tbody>
      <% v.rows.each do |row| t = row.txn %>
        <tr class="<%= row.cleared? ? "cleared" : "" %><%= v.after_statement?(row) ? " later" : "" %>"<%= v.after_statement?(row) ? %( title="Dated after the statement closed") : "" %>>
          <td class="check-col">
            <input type="hidden" name="ids" value="<%= t.id %>">
            <input type="checkbox" name="clear" value="<%= t.id %>" aria-label="On statement: #<%= t.id %>"<%= row.cleared? ? " checked" : "" %>>
          </td>
          <td class="id"><%= t.id %></td>
          <td class="date"><%= t.date %></td>
          <td><%= h t.description %></td>
          <td class="num-col"><% if row.outflow? %><%= money row.magnitude %><% end %></td>
          <td class="num-col"><% unless row.outflow? %><%= money row.magnitude %><% end %></td>
        </tr>
      <% end %>
      </tbody>
    </table>
    <div class="bar">
      <button type="submit" class="nojs-only">Save ticks</button>
    </div>
  </form>

  <form method="post" action="/reconcile/commit" class="bar commit">
    <input type="hidden" name="account" value="<%= h v.account %>">
    <% if (st = @statement) && (d = v.as_of) %>
      <input type="hidden" name="statement" value="<%= h st %>">
      <input type="hidden" name="as_of" value="<%= h d %>">
      <span>Commit: <strong class="num"><%= Money.format(v.statement.not_nil!) %></strong> as of <strong><%= d %></strong></span>
      <label class="checkbox"><input type="checkbox" name="adjust" value="1"> Book a small residual to Expenses:ShortsAndOverages</label>
      <button type="submit" class="primary">Commit reconciliation</button>
    <% else %>
      <span class="muted">Enter the statement date and closing balance above, then commit.</span>
    <% end %>
  </form>
  <p class="hint">Commit locks the ticked transactions in — only if the cleared balance equals the statement. A real, explainable difference (a fee, a forgotten bill) should be recorded to its proper account instead of adjusted away. Lines dated after the statement closed are greyed; they'll be on the next one.</p>
<% end %>

<% unless @past.empty? %>
<section class="card">
  <h2>Past reconciliations</h2>
  <table class="ledger compact">
    <thead><tr><th>Statement</th><th class="num-col">Balance</th><th class="num-col">Locked</th><th>Finalized</th></tr></thead>
    <tbody>
    <% @past.reverse.each do |rec| %>
      <tr><td class="date"><%= rec.as_of %></td><td class="num-col"><%= money rec.statement %></td><td class="num-col"><%= rec.transaction_ids.size %></td><td class="date muted"><%= rec.statement_date ? rec.date : "—" %></td></tr>
    <% end %>
    </tbody>
  </table>
</section>
<% end %>
