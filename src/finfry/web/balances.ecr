<header class="page-head">
  <h1>Balances</h1>
  <p class="sub">Every account's balance<% if p = @prefix %> under <strong><%= h p %></strong><% end %>, grouped under its parents with their totals</p>
</header>

<form class="filters" method="get" action="/balances">
  <label>Accounts
    <select name="prefix">
      <option value="">All accounts</option>
      <%= account_options @accounts, @prefix %>
    </select>
  </label>
  <button type="submit">Show</button>
  <a class="button quiet" href="/balances">All</a>
</form>

<% if @nodes.empty? %>
  <p class="empty">No balances to show.</p>
<% else %>
  <table class="ledger tree">
    <thead><tr><th>Account</th><th class="num-col">Balance</th><th></th></tr></thead>
    <tbody>
    <% @nodes.each do |n| %>
      <tr class="depth-<%= n.depth %><%= n.leaf? ? "" : " parent" %>">
        <td><a href="<%= url "/register", account: n.name %>" title="<%= h n.name %>"><%= h n.label %></a></td>
        <td class="num-col"><%= money n.balance %></td>
        <td class="actions"><% if n.leaf? && reconcilable?(n.name) %><a class="button quiet small" href="<%= url "/reconcile", account: n.name %>">Reconcile</a><% end %></td>
      </tr>
    <% end %>
    </tbody>
  </table>
<% end %>
