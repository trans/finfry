<header class="page-head">
  <h1>Register<% if a = @view.account %> <span class="muted"><%= h a %></span><% end %></h1>
  <p class="sub"><% if @view.account %>Account view with running balance<% else %>Transactions, newest first<% end %><% if @since || @until %> · <%= h(@since || "…") %> – <%= h(@until || "…") %> · <a href="<%= url "/register", account: @view.account, all: "1" %>">all time</a><% else %> · all time<% end %></p>
</header>

<form class="filters" method="get" action="/register">
  <label>Account
    <select name="account">
      <option value="">Any account</option>
      <%= account_filter_options %>
    </select>
  </label>
  <label>From <input type="date" name="since" value="<%= h(@since || "") %>"></label>
  <label>To <input type="date" name="until" value="<%= h(@until || "") %>"></label>
  <label>Memo <input name="q" value="<%= param "q" %>" placeholder="contains…"></label>
  <label>Min <input name="min" value="<%= param "min" %>" size="7" inputmode="decimal"></label>
  <label>Max <input name="max" value="<%= param "max" %>" size="7" inputmode="decimal"></label>
  <button type="submit">Filter</button>
  <a class="button quiet" href="/register">This month</a>
</form>

<% if @view.empty? %>
  <p class="empty">No transactions match. <a href="/record">Record an entry</a>, or <a href="<%= url "/register", account: @view.account, all: "1" %>">show all time</a>.</p>
<% elsif account = @view.account %>
  <table class="ledger">
    <thead><tr><th>#</th><th>Date</th><th>Memo</th><th class="num-col">Amount</th><th class="num-col running">Balance</th></tr></thead>
    <tbody>
    <% @view.rows.reverse_each do |row| t = row.txn %>
      <tr>
        <td class="id"><%= t.id %></td>
        <td class="date"><%= t.date %></td>
        <td><%= h t.description %><% if t.recurrence %> <span class="tag"><%= t.recurrence %></span><% end %></td>
        <td class="num-col"><%= money row.leg.not_nil! %></td>
        <td class="num-col running"><%= money row.running.not_nil! %></td>
      </tr>
    <% end %>
    </tbody>
  </table>
<% else %>
  <table class="ledger">
    <thead><tr><th>#</th><th>Date</th><th>Memo</th><th>Postings</th><th class="num-col">Amount</th></tr></thead>
    <tbody>
    <% @view.rows.reverse_each do |row| t = row.txn %>
      <tr>
        <td class="id"><%= t.id %></td>
        <td class="date"><%= t.date %></td>
        <td><%= h t.description %><% if t.recurrence %> <span class="tag"><%= t.recurrence %></span><% end %></td>
        <td class="postings"><% t.postings.each do |p| %><div><a href="<%= url "/register", account: p.account %>"><%= h p.account %></a></div><% end %></td>
        <td class="num-col postings"><% t.postings.each do |p| %><div><%= money p.amount %></div><% end %></td>
      </tr>
    <% end %>
    </tbody>
  </table>
<% end %>
