<header class="page-head">
  <h1>Income statement</h1>
  <p class="sub">What came in and went out during <strong><%= @statement.month %></strong></p>
</header>

<form class="filters month-form" method="get" action="/income">
  <a class="button quiet" href="<%= url "/income", month: prev_month(@statement.month) %>" aria-label="Previous month">‹</a>
  <label>Month <input type="month" name="month" placeholder="YYYY-MM" pattern="[0-9]{4}-[0-9]{2}" title="Month as YYYY-MM" value="<%= @statement.month %>"></label>
  <a class="button quiet" href="<%= url "/income", month: next_month(@statement.month) %>" aria-label="Next month">›</a>
  <button type="submit">Show</button>
</form>

<% if @statement.empty? %>
  <p class="empty">No transactions for <%= @statement.month %>.</p>
<% else %>
  <table class="ledger statement">
    <tbody>
      <tr class="section"><th colspan="2">Income</th></tr>
      <% @statement.income.each do |(account, cents)| %>
        <tr><td><a href="<%= url "/register", account: account, month: @statement.month %>"><%= h account %></a></td><td class="num-col"><%= money cents %></td></tr>
      <% end %>
      <tr class="subtotal"><th>Total income</th><td class="num-col"><%= money @statement.total_income %></td></tr>
      <tr class="section"><th colspan="2">Expenses</th></tr>
      <% @statement.expenses.each do |(account, cents)| %>
        <tr><td><a href="<%= url "/register", account: account, month: @statement.month %>"><%= h account %></a></td><td class="num-col"><%= money cents %></td></tr>
      <% end %>
      <tr class="subtotal"><th>Total expenses</th><td class="num-col"><%= money @statement.total_expenses %></td></tr>
      <tr class="total"><th>Net</th><td class="num-col"><%= money @statement.net %></td></tr>
    </tbody>
  </table>
<% end %>
