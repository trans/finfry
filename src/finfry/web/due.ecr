<header class="page-head">
  <h1>Due</h1>
  <p class="sub">Occurrences generated by your recurring rules. Decide each one, then post — only ok'd entries reach the ledger.</p>
</header>

<% if @newly_due > 0 %>
<form method="post" action="/due/generate" class="bar catch-up">
  <span><strong><%= @newly_due %></strong> new <%= @newly_due == 1 ? "occurrence has" : "occurrences have" %> come due from your recurring rules and <%= @newly_due == 1 ? "isn't" : "aren't" %> in the queue yet.</span>
  <button type="submit" class="primary">Add <%= @newly_due == 1 ? "it" : "them" %> to the queue</button>
</form>
<% end %>

<% if @entries.empty? %>
  <p class="empty">Nothing in the queue. <a href="/recurring">Recurring rules</a> generate occurrences here as their dates come up.</p>
<% else %>
  <form method="post" action="/due/stage" data-autosave>
    <table class="ledger">
      <thead><tr><th>#</th><th>Date</th><th>Entry</th><th class="num-col">Amount</th><th>Decision</th><th></th></tr></thead>
      <tbody>
      <% @entries.each do |e| %>
        <tr>
          <td class="id"><%= e.id %></td>
          <td class="date"><%= e.date %></td>
          <td><%= h(e.description.empty? ? e.postings.map(&.account).join(" / ") : e.description) %> <span class="tag"><%= e.cadence %></span>
            <div class="postings muted"><% e.postings.each do |p| %><span><%= h p.account %></span> <% end %></div></td>
          <td class="num-col"><%= money e.postings.first.amount.abs %></td>
          <td>
            <select name="status-<%= e.id %>" aria-label="Decision for #<%= e.id %>" class="decision <%= e.status %>">
              <option value="pending"<%= e.status == "pending" ? " selected" : "" %>>Pending</option>
              <option value="ok"<%= e.status == "ok" ? " selected" : "" %>>Ok — post it</option>
              <option value="skip"<%= e.status == "skip" ? " selected" : "" %>>Skip — drop it</option>
            </select>
          </td>
          <td class="actions"><details class="adjust"><summary>Adjust</summary>
            <div class="adjust-form" data-edit="/due/edit" data-id="<%= e.id %>">
              <label>Amount <input form="edit-<%= e.id %>" name="amount" value="<%= Money.format(e.postings.first.amount.abs).lchop('$') %>" size="8" inputmode="decimal"></label>
              <label>Date <input form="edit-<%= e.id %>" type="date" name="date" value="<%= e.date %>"></label>
              <label>Memo <input form="edit-<%= e.id %>" name="memo" value="<%= h e.description %>"></label>
              <button form="edit-<%= e.id %>" type="submit" class="small">Save &amp; mark ok</button>
            </div>
          </details></td>
        </tr>
      <% end %>
      </tbody>
    </table>
    <div class="bar">
      <button type="submit" class="nojs-only">Save decisions</button>
      <span class="muted"><span data-field="staged"><%= staged %></span> staged</span>
    </div>
  </form>
  <% @entries.each do |e| %><form id="edit-<%= e.id %>" method="post" action="/due/edit"><input type="hidden" name="id" value="<%= e.id %>"></form><% end %>
  <form method="post" action="/due/stage" class="bar">
    <% @entries.each do |e| %><input type="hidden" name="status-<%= e.id %>" value="ok"><% end %>
    <button type="submit" class="quiet">Ok all</button>
    <span class="muted">Stage every entry to post; you can still change any one.</span>
  </form>
  <form method="post" action="/due/post" class="bar">
    <button type="submit" class="primary">Post staged decisions</button>
    <span class="muted">Posts every ok'd entry as a normal, undoable transaction and drops the skipped ones. Pending entries stay for next time.</span>
  </form>
<% end %>
